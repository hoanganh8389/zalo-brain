# (Docker on the VPS). Moved here from core/channel-gateway/_library/ (never committed there either). It needs its own
# git repository (zalo-hub/.git, initialised 2026-09-30, branch main, no remote yet); it must never ride along
# with the plugin repo or upload.
/zalo-hub/
# WP-13 DL-5 — module diagnostic pages and probes (same list as bin/dev-only-paths.txt).
/core/channel-gateway/includes/class-sprint-diagnostic.php
/core/channel-gateway/includes/class-phase-037-diagnostic.php
/modules/twinchat/includes/diagnostics/
