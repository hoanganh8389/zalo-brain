{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "core.channel-gateway",
  "owner": "core/channel-gateway",
  "installer_id": "blog_resolver_inbox",
  "current_version": "1.9.0",
  "version_option": "bizcity_blog_resolver_inbox_db_version",
  "tables": {
    "global_inbox_admin": {
      "since": "1.0.0",
      "purpose": "Outbound + inbound message log from all channels (Zalo, Facebook, WebChat, Telegram). One row per message dispatched or received via Gateway Sender.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":             { "type": "BIGINT AUTO_INCREMENT",    "since": "1.0.0", "pk": true },
        "client_id":      { "type": "VARCHAR(32)",              "since": "1.0.0" },
        "client_name":    { "type": "VARCHAR(255)",             "since": "1.0.0" },
        "platform_type":  { "type": "VARCHAR(20)",              "since": "1.0.0" },
        "page_id":        { "type": "VARCHAR(40)",              "since": "1.0.0" },
        "message_id":     { "type": "VARCHAR(64)",              "since": "1.0.0" },
        "message_text":   { "type": "TEXT",                     "since": "1.0.0" },
        "message_type":   { "type": "VARCHAR(10)",              "since": "1.0.0" },
        "created_at":     { "type": "DATETIME",                 "since": "1.0.0" },
        "blog_id":        { "type": "INT DEFAULT 0",            "since": "1.0.0" },
        "flow_id":        { "type": "INT DEFAULT 0",            "since": "1.0.0" },
        "reminded_at":    { "type": "DATETIME NULL DEFAULT NULL", "since": "1.0.0" },
        "reminder_msg_id":{ "type": "INT DEFAULT 0",            "since": "1.0.0" },
        "meta":           { "type": "LONGTEXT",                 "since": "1.0.0" }
      },
      "indexes": {}
    },
    "bizcity_channel_messages": {
      "since": "1.3.0",
      "purpose": "Unified inbound + outbound message ledger across all channel adapters (Zalo OA, Facebook, WebChat, Telegram, Email). One row per message. Managed by BizCity_Channel_Messages::maybe_install() with OPTION bizcity_channel_messages_schema. R-DCL debt paid 2026-06-13 (Sprint ZA-5 probe). Schema version 1.2.0 in class.",
      "owner_class": "BizCity_Channel_Messages",
      "installer_option": "bizcity_channel_messages_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.3.0", "pk": true },
        "blog_id":           { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",      "since": "1.3.0" },
        "platform":          { "type": "VARCHAR(40) NOT NULL DEFAULT ''",          "since": "1.3.0" },
        "direction":         { "type": "TINYINT UNSIGNED NOT NULL DEFAULT 0",     "since": "1.3.0", "note": "1=inbound, 2=outbound" },
        "chat_id":           { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.3.0" },
        "user_psid":         { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.3.0" },
        "message_id":        { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.3.0" },
        "thread_id":         { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.3.0" },
        "event_type":        { "type": "VARCHAR(40) NOT NULL DEFAULT 'message'",  "since": "1.3.0" },
        "body":              { "type": "LONGTEXT NULL",                           "since": "1.3.0" },
        "payload_json":      { "type": "LONGTEXT NULL",                           "since": "1.3.0" },
        "webhook_log_id":    { "type": "BIGINT UNSIGNED NULL",                    "since": "1.3.1" },
        "webhook_log_date":  { "type": "DATE NULL",                               "since": "1.3.1", "note": "partition pointer for wp_{Y_M_D}_webhook_log" },
        "character_id":      { "type": "BIGINT UNSIGNED NULL",                    "since": "1.3.1", "note": "Guru routed for this message" },
        "responder_kind":    { "type": "VARCHAR(10) NULL",                        "since": "1.3.2", "enum": ["auto","manual","hybrid","system"] },
        "responder_user_id": { "type": "BIGINT UNSIGNED NULL",                    "since": "1.3.2", "note": "WP user who sent; NULL for auto" },
        "status":            { "type": "VARCHAR(20) NOT NULL DEFAULT ''",         "since": "1.3.0", "enum": ["queued","sent","failed","received"] },
        "error":             { "type": "VARCHAR(500) NOT NULL DEFAULT ''",        "since": "1.3.0" },
        "created_at":        { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.3.0" },
        "processed_at":      { "type": "DATETIME NULL",                           "since": "1.3.0" }
      },
      "indexes": {
        "idx_blog_platform":    { "type": "KEY", "cols": ["blog_id", "platform"],          "since": "1.3.0" },
        "idx_chat":             { "type": "KEY", "cols": ["chat_id"],                      "since": "1.3.0" },
        "idx_user":             { "type": "KEY", "cols": ["user_psid"],                    "since": "1.3.0" },
        "idx_msg":              { "type": "KEY", "cols": ["platform", "message_id"],       "since": "1.3.0" },
        "idx_created":          { "type": "KEY", "cols": ["created_at"],                   "since": "1.3.0" },
        "idx_character":        { "type": "KEY", "cols": ["character_id"],                 "since": "1.3.1" },
        "idx_log":              { "type": "KEY", "cols": ["webhook_log_date", "webhook_log_id"], "since": "1.3.1" },
        "idx_responder_user":   { "type": "KEY", "cols": ["responder_user_id"],            "since": "1.3.2" },
        "idx_responder_kind":   { "type": "KEY", "cols": ["responder_kind"],               "since": "1.3.2" }
      }
    },
    "bizcity_channel_bindings": {
      "since": "1.1.0",
      "purpose": "R-GCB SoT — Guru × Channel mapping. (platform, account_id) → character_id. Shipped Phase 0.33 M1 (2026-05-26), formalized in DCL 2026-06-03 alongside Wave 0 GURU-UI ship.",
      "owner_class": "BizCity_Channel_Binding",
      "installer_option": "bizcity_channel_bindings_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                  { "type": "BIGINT UNSIGNED AUTO_INCREMENT", "since": "1.1.0", "pk": true },
        "blog_id":             { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "platform":            { "type": "VARCHAR(40) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "account_id":          { "type": "VARCHAR(190) NOT NULL DEFAULT ''", "since": "1.1.0" },
        "character_id":        { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "status":              { "type": "TINYINT UNSIGNED NOT NULL DEFAULT 1", "since": "1.1.0" },
        "auto_reply":          { "type": "TINYINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "mode":                { "type": "VARCHAR(20) NOT NULL DEFAULT 'auto'", "since": "1.2.0", "enum": ["auto","manual","hybrid","roundrobin"] },
        "responder_pool_json": { "type": "LONGTEXT NULL", "since": "1.2.0" },
        "current_pool_index":  { "type": "INT NOT NULL DEFAULT 0", "since": "1.2.0" },
        "fallback_assignee":   { "type": "BIGINT UNSIGNED NULL", "since": "1.1.0" },
        "meta_json":           { "type": "LONGTEXT NULL", "since": "1.1.0" },
        "office_hours_json":   { "type": "LONGTEXT NULL", "since": "1.6.1", "note": "PHASE-0.60A Bot Studio — per-binding office hours + pause/mention flags. Written only when caller passes it (isset-gated), unlike meta_json which is unconditionally overwritten." },
        "policy_json":         { "type": "LONGTEXT NULL", "since": "1.7.0", "note": "PHASE-0.60E EA-1 Bot Studio — per-binding behavior policy (allowlist mode/uids). Written only via BizCity_Channel_Binding::save_policy()'s narrow single-column UPDATE, never through upsert()." },
        "created_at":          { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.1.0" },
        "updated_at":          { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.1.0" }
      },
      "indexes": {
        "uniq_binding":   { "type": "UNIQUE KEY", "cols": ["blog_id", "platform", "account_id"], "since": "1.1.0" },
        "idx_character":  { "type": "KEY",        "cols": ["character_id"], "since": "1.1.0" },
        "idx_status":     { "type": "KEY",        "cols": ["status"], "since": "1.1.0" },
        "idx_mode":       { "type": "KEY",        "cols": ["mode"], "since": "1.2.0" }
      }
    },
    "bizcity_channel_user_links": {
      "since": "1.4.0",
      "purpose": "Tenant-shard external channel identity to WordPress user mapping for Zone 1 identity linking (Facebook Messenger and Zalo OA). Rows are scoped by blog_id; raw link tokens are never persisted.",
      "owner_class": "BizCity_Channel_User_Linker",
      "installer_option": "bizcity_channel_user_links_schema",
      "storage": "prefix",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                 { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.4.0", "pk": true },
        "blog_id":            { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",      "since": "1.4.0" },
        "platform":           { "type": "VARCHAR(40) NOT NULL DEFAULT ''",          "since": "1.4.0", "enum": ["FB_MESS", "ZALO_OA"] },
        "external_user_id":   { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.4.0" },
        "account_id":         { "type": "VARCHAR(190) NOT NULL DEFAULT ''",        "since": "1.4.0" },
        "wp_user_id":         { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",      "since": "1.4.0" },
        "status":             { "type": "VARCHAR(20) NOT NULL DEFAULT 'pending'",  "since": "1.4.0", "enum": ["pending", "linked", "unlinked"] },
        "link_token_hash":    { "type": "CHAR(64) NOT NULL DEFAULT ''",             "since": "1.4.0" },
        "token_expires":      { "type": "DATETIME NULL",                            "since": "1.4.0" },
        "linked_at":          { "type": "DATETIME NULL",                            "since": "1.4.0" },
        "created_at":         { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.4.0" },
        "updated_at":         { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.4.0" }
      },
      "indexes": {
        "uniq_identity": { "type": "UNIQUE KEY", "cols": ["blog_id", "platform", "external_user_id", "account_id"], "since": "1.4.0" },
        "idx_wp_user":    { "type": "KEY",        "cols": ["blog_id", "wp_user_id"],                            "since": "1.4.0" },
        "idx_token":      { "type": "KEY",        "cols": ["link_token_hash"],                                  "since": "1.4.0" },
        "idx_status":     { "type": "KEY",        "cols": ["status"],                                          "since": "1.4.0" }
      }
    },
    "bizcity_identity_contacts": {
      "since": "1.6.0",
      "purpose": "Durable canonical customer identity root. Core-owned and CRM-optional; WordPress user is an optional projection.",
      "owner_class": "BizCity_Identity_Hub",
      "installer_option": "bizcity_identity_hub_schema",
      "storage": "prefix",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                  { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.5.0", "pk": true },
        "identity_uuid":       { "type": "CHAR(36) NOT NULL",                         "since": "1.5.0" },
        "blog_id":             { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",       "since": "1.5.0" },
        "primary_wp_user_id":  { "type": "BIGINT UNSIGNED NULL",                       "since": "1.5.0" },
        "display_label":       { "type": "VARCHAR(190) NULL",                         "since": "1.5.0" },
        "merged_into_uuid":    { "type": "CHAR(36) NULL",                              "since": "1.5.0" },
        "status":              { "type": "VARCHAR(20) NOT NULL DEFAULT 'active'",     "since": "1.5.0" },
        "created_at":          { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.5.0" },
        "updated_at":          { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.5.0" }
      },
      "indexes": {
        "uniq_uuid":        { "type": "UNIQUE KEY", "cols": ["identity_uuid"],                    "since": "1.5.0" },
        "idx_blog_wp_user": { "type": "KEY",        "cols": ["blog_id", "primary_wp_user_id"], "since": "1.5.0" },
        "idx_merged":       { "type": "KEY",        "cols": ["merged_into_uuid"],                "since": "1.5.0" },
        "idx_status":       { "type": "KEY",        "cols": ["status"],                          "since": "1.5.0" }
      }
    },
    "bizcity_identity_bindings": {
      "since": "1.6.0",
      "purpose": "Scoped channel aliases bound to a durable canonical customer identity.",
      "owner_class": "BizCity_Identity_Hub",
      "installer_option": "bizcity_identity_hub_schema",
      "storage": "prefix",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":             { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",  "since": "1.5.0", "pk": true },
        "identity_uuid":  { "type": "CHAR(36) NOT NULL",                          "since": "1.5.0" },
        "blog_id":       { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",        "since": "1.5.0" },
        "platform":      { "type": "VARCHAR(32) NOT NULL DEFAULT ''",           "since": "1.5.0" },
        "account_id":    { "type": "VARCHAR(190) NOT NULL DEFAULT ''",           "since": "1.5.0" },
        "external_ref":  { "type": "VARCHAR(190) NOT NULL DEFAULT ''",           "since": "1.5.0" },
        "is_stable":     { "type": "TINYINT(1) NOT NULL DEFAULT 1",              "since": "1.5.0" },
        "first_seen_at": { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.5.0" },
        "last_seen_at":  { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.5.0" }
      },
      "indexes": {
        "uniq_binding": { "type": "UNIQUE KEY", "cols": ["blog_id", "platform", "account_id", "external_ref"], "since": "1.5.0" },
        "idx_identity":  { "type": "KEY",        "cols": ["identity_uuid"],                                      "since": "1.5.0" },
        "idx_stable":    { "type": "KEY",        "cols": ["blog_id", "is_stable"],                              "since": "1.5.0" }
      }
    },
    "bizcity_bot_secrets": {
      "since": "1.8.0",
      "purpose": "PHASE-0.60E D-E1 phương án A — one narrow encrypted table for per-character Bot Studio media keys (TTS/STT/tạo nhạc/Apify/Tavily) that 1API doesn't cover. Deliberately NOT characters.settings (copied whole by export/duplicate — 0.60A §0.3). BizCity_Codec::encrypt_json_payload() (AES-256-CBC + HMAC-SHA256), key = wp_salt('auth') via bizcity_bot_secrets_key filter, same shape as BizCity_Channel_Conversation_Archive::archive_key().",
      "owner_class": "BizCity_Bot_Secrets_Repo",
      "installer_option": "bizcity_bot_secrets_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":            { "type": "BIGINT UNSIGNED AUTO_INCREMENT", "since": "1.8.0", "pk": true },
        "blog_id":       { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.8.0" },
        "character_id":  { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.8.0" },
        "field":         { "type": "VARCHAR(40) NOT NULL DEFAULT ''", "since": "1.8.0", "enum": ["tts_api_keys", "stt_api_key", "music_api_key", "apify_token", "tavily_api_key"], "note": "tts_api_keys is the only multi-value field (EB-6 rotation); the rest are single-value \"để trống để giữ nguyên\"." },
        "ciphertext":    { "type": "LONGTEXT NULL", "since": "1.8.0", "note": "Encrypted {\"keys\":[...]} — plaintext never stored, never returned by any REST route (only *_masked + has_*)." },
        "updated_at":    { "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP", "since": "1.8.0" },
        "updated_by":    { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.8.0" }
      },
      "indexes": {
        "uniq_field":    { "type": "UNIQUE KEY", "cols": ["blog_id", "character_id", "field"], "since": "1.8.0" },
        "idx_character": { "type": "KEY",        "cols": ["blog_id", "character_id"],          "since": "1.8.0" }
      }
    },
    "bizcity_usage_ledger": {
      "since": "1.9.0",
      "purpose": "PHASE-0.107 S107-L9/L12 (D107-13) — the site's COPY of its own client ledger (contract usage-ledger@1, cell → Hub forwarder → POST bizcity-channel/v1/usage/ledger-ingest). One row per cell ledger row, UNIQUE(account_id, account_seq). Billed columns only: no cost, no real tokens, no markup, no raw hash. bound_user_id / actor_user_id resolved and frozen at receive time. Site keeps rows forever (Q107-14).",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":            { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.9.0", "pk": true },
        "account_id":    { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "bridge_account_id or web-<key>" },
        "account_seq":   { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "row_ref":       { "type": "VARCHAR(16) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "last 8 hex of the cell row_hash" },
        "kind":          { "type": "VARCHAR(12) NOT NULL DEFAULT 'llm'", "since": "1.9.0", "enum": ["llm", "tool", "adjust", "reversal"] },
        "occurred_at":   { "type": "DATETIME NOT NULL", "since": "1.9.0", "note": "UTC" },
        "occurred_day":  { "type": "DATE NOT NULL", "since": "1.9.0", "note": "site-local date" },
        "platform":      { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "channel_ref":   { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "bound_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "actor_role":    { "type": "VARCHAR(12) NOT NULL DEFAULT 'customer'", "since": "1.9.0" },
        "actor_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "contact_key":   { "type": "VARCHAR(16) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "first 12 hex of contact_ref (never the 64-hex)" },
        "thread_ref":    { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "turn_ref":      { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "surface":       { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "model":         { "type": "VARCHAR(120) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "tool":          { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "tool_kind":     { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0", "enum": ["", "builtin", "mcp"] },
        "units":         { "type": "DECIMAL(14,4) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_tokens": { "type": "BIGINT NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_usd":    { "type": "DECIMAL(18,8) NULL", "since": "1.9.0", "note": "NULL = tool not priced by the Hub table" },
        "price_source":  { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0", "enum": ["cell", "hub_unit_price", "hub_other"] },
        "price_version": { "type": "VARCHAR(40) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "is_error":      { "type": "TINYINT(1) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "resolve_state": { "type": "VARCHAR(16) NOT NULL DEFAULT 'ok'", "since": "1.9.0", "enum": ["ok", "unknown_account"] },
        "received_at":   { "type": "DATETIME NOT NULL", "since": "1.9.0" }
      },
      "indexes": {
        "uniq_account_seq": { "type": "UNIQUE KEY", "cols": ["account_id", "account_seq"], "since": "1.9.0" },
        "idx_account_time": { "type": "KEY", "cols": ["account_id", "occurred_at"], "since": "1.9.0" },
        "idx_bound_time":   { "type": "KEY", "cols": ["bound_user_id", "occurred_at"], "since": "1.9.0" },
        "idx_actor_time":   { "type": "KEY", "cols": ["actor_user_id", "occurred_at"], "since": "1.9.0" },
        "idx_thread":       { "type": "KEY", "cols": ["thread_ref"], "since": "1.9.0" },
        "idx_day_account":  { "type": "KEY", "cols": ["occurred_day", "account_id"], "since": "1.9.0" }
      }
    },
    "bizcity_usage_daily": {
      "since": "1.9.0",
      "purpose": "PHASE-0.107 S107-L9 — aggregate of bizcity_usage_ledger per (day, platform, account_id, bound_user_id, actor_role, actor_user_id, kind); rebuilt from the ledger for every (day, account) an ingest touched. Tiles + daily chart of menu Sử dụng.",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":            { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.9.0", "pk": true },
        "day":           { "type": "DATE NOT NULL", "since": "1.9.0" },
        "platform":      { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "account_id":    { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "bound_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "actor_role":    { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "actor_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "kind":          { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "billed_tokens": { "type": "BIGINT NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_usd":    { "type": "DECIMAL(18,8) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "turns":         { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "threads":       { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "tool_calls":    { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "updated_at":    { "type": "DATETIME NOT NULL", "since": "1.9.0" }
      },
      "indexes": {
        "uniq_group":      { "type": "UNIQUE KEY", "cols": ["day", "platform", "account_id", "bound_user_id", "actor_role", "actor_user_id", "kind"], "since": "1.9.0" },
        "idx_account_day": { "type": "KEY", "cols": ["account_id", "day"], "since": "1.9.0" },
        "idx_bound_day":   { "type": "KEY", "cols": ["bound_user_id", "day"], "since": "1.9.0" },
        "idx_actor_day":   { "type": "KEY", "cols": ["actor_user_id", "day"], "since": "1.9.0" }
      }
    },
    "bizcity_account_plans": {
      "since": "1.10.0",
      "purpose": "PHASE-0.107 round 4 S107-L14 (doc 66 §8.1) — the client's commercial plan (trial / pro / other) per ACCOUNT ID, per blog. The site is the source of truth of the plan; the cell is the source of truth of token counts (no token counter is stored). plan_mode defaults to off: no row / off = nothing is blocked. plan_version is monotonic per account and bumped on every change (the cell ignores older versions). Enforced on the SITE (round 5): BizCity_Usage_Plan_Enforce flips the number's AI switch; used tokens are SUM(billed_tokens) of bizcity_usage_ledger and are not stored here. Deliberately NOT a column of the Hub mirror bizcity_zalo_accounts, not BizCity_Plans, not master_level.",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                      { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.10.0", "pk": true },
        "platform":                { "type": "VARCHAR(24) NOT NULL DEFAULT 'zalo_personal'", "since": "1.10.0" },
        "account_id":              { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.10.0" },
        "plan_code":               { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.10.0", "note": "trial | pro | any short slug" },
        "state":                   { "type": "VARCHAR(12) NOT NULL DEFAULT 'none'", "since": "1.10.0", "enum": ["none", "trial", "active", "expired"] },
        "plan_mode":               { "type": "VARCHAR(3) NOT NULL DEFAULT 'off'", "since": "1.10.0", "enum": ["on", "off"] },
        "plan_version":            { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0" },
        "started_at":              { "type": "DATETIME NULL", "since": "1.10.0", "note": "UTC; trial: first successful login of the number" },
        "valid_until":             { "type": "DATETIME NULL", "since": "1.10.0", "note": "UTC" },
        "monthly_token_allowance": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "BILLED tokens; 0 = unlimited" },
        "allowance_period":        { "type": "VARCHAR(12) NOT NULL DEFAULT 'month'", "since": "1.10.0", "enum": ["month", "since_start"] },
        "notice_text":             { "type": "VARCHAR(500) NOT NULL DEFAULT ''", "since": "1.10.0" },
        "ai_off_by_plan":           { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.11.0", "note": "plan_expired | plan_allowance_exhausted when WE switched the number's AI off; empty = not ours" },
        "ai_off_at":                { "type": "DATETIME NULL", "since": "1.11.0" },
        "enforce_error":            { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.11.0", "note": "last failed AI-switch call; retried by the next trigger" },
        "last_notice_at":           { "type": "DATETIME NULL", "since": "1.11.0", "note": "owner notice dedupe: one per account per day" },
        "last_notice_reason":       { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.11.0" },
        "last_order_id":           { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "Woo order that last extended the plan (L16)" },
        "last_sold_by":            { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "WP user of that order" },
        "updated_by":              { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0" },
        "created_at":              { "type": "DATETIME NOT NULL", "since": "1.10.0" },
        "updated_at":              { "type": "DATETIME NOT NULL", "since": "1.10.0" }
      },
      "indexes": {
        "uniq_account": { "type": "UNIQUE KEY", "cols": ["platform", "account_id"], "since": "1.10.0" },
        "idx_state":    { "type": "KEY", "cols": ["state", "valid_until"], "since": "1.10.0" }
      }
    }
  },
