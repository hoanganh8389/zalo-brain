{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "core.crm",
  "owner": "core/crm",
  "installer_id": "crm-spine",
  "current_version": "2.0.0",
  "version_option": "bizcity_crm_db_ver",
  "tables": {
    "bizcity_crm_contacts": {
      "since": "1.0.0",
      "purpose": "Unified contact entity. Primary CRM record across all channels (FB, Zalo, Web, IG, WA, Telegram, Email). Deduped by (email, phone, platform uid). v1.18.0 adds lead_score + segment for broadcast segmentation. v1.36.0 (PHASE-0.60B) reconciles this declaration with the active installer (additional_attributes, the M8.W2 unification columns, acquisition columns) and adds the real birthday column pair.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "name": {
          "type": "VARCHAR(190) NOT NULL DEFAULT ''",
          "since": "1.0.0"
        },
        "first_name": {
          "type": "VARCHAR(95) NULL",
          "since": "1.19.0",
          "comment": "M8.W2 legacy biz_contacts absorption (migrate_phase_040). Declared retroactively in 1.36.0 — R-DCL drift fix."
        },
        "last_name": {
          "type": "VARCHAR(95) NULL",
          "since": "1.19.0",
          "comment": "M8.W2 (migrate_phase_040). Declared retroactively in 1.36.0."
        },
        "title": {
          "type": "VARCHAR(120) NULL",
          "since": "1.19.0",
          "comment": "M8.W2 (migrate_phase_040). Declared retroactively in 1.36.0."
        },
        "account_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.19.0",
          "comment": "B2B account FK (migrate_phase_040). Declared retroactively in 1.36.0."
        },
        "email": {
          "type": "VARCHAR(190) NULL",
          "since": "1.0.0"
        },
        "phone": {
          "type": "VARCHAR(32) NULL",
          "since": "1.0.0"
        },
        "birthday": {
          "type": "DATE NULL",
          "since": "1.36.0",
          "comment": "PHASE-0.60B — real column so the daily birthday read is indexed, never a JSON scan. Filled only when empty (staff input wins); source recorded in additional_attributes.birthday_meta."
        },
        "birthday_md": {
          "type": "CHAR(5) NULL",
          "since": "1.36.0",
          "comment": "PHASE-0.60B — MM-DD written together with birthday (or alone when the year is unknown). Plain index instead of a MySQL-8 expression index (Q-B1: 5.7/MariaDB safe)."
        },
        "avatar_url": {
          "type": "TEXT NULL",
          "since": "1.0.0"
        },
        "additional_attributes": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0",
          "comment": "JSON. Was misdeclared as additional_json until 1.36.0 (that column never existed in the installer)."
        },
        "wp_user_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.19.0",
          "comment": "Declared retroactively in 1.36.0."
        },
        "owner_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.19.0",
          "comment": "M8.W2 (migrate_phase_040). Declared retroactively in 1.36.0."
        },
        "tags_json": {
          "type": "LONGTEXT NULL",
          "since": "1.19.0",
          "comment": "M8.W2 (migrate_phase_040). Declared retroactively in 1.36.0."
        },
        "acquisition_source": {
          "type": "VARCHAR(64) NULL",
          "since": "1.19.0",
          "comment": "migrate_phase_035 $add_column. Declared retroactively in 1.36.0."
        },
        "acquisition_meta_json": {
          "type": "LONGTEXT NULL",
          "since": "1.19.0",
          "comment": "migrate_phase_035 $add_column. Declared retroactively in 1.36.0."
        },
        "points_balance_cache": {
          "type": "INT NOT NULL DEFAULT 0",
          "since": "1.19.0",
          "comment": "migrate_phase_035 $add_column. Declared retroactively in 1.36.0."
        },
        "lead_score": {
          "type": "TINYINT UNSIGNED NOT NULL DEFAULT 0",
          "since": "1.18.0",
          "comment": "0-100 scoring for broadcast segment targeting"
        },
        "segment": {
          "type": "VARCHAR(32) NOT NULL DEFAULT ''",
          "since": "1.18.0",
          "comment": "A | B | C | VIP — broadcast audience classification"
        },
        "platform": {
          "type": "VARCHAR(32) NULL",
          "since": "1.25.0",
          "comment": "FACEBOOK | ZALO | WEBCHAT | WEB | EMAIL | IG | WA | TELEGRAM (R-UNIFY GAP-B)"
        },
        "platform_uid": {
          "type": "VARCHAR(190) NULL",
          "since": "1.25.0"
        },
        "source": {
          "type": "VARCHAR(64) NULL",
          "since": "1.25.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "deleted_at": {
          "type": "DATETIME NULL",
          "since": "1.19.0",
          "comment": "Soft delete (migrate_phase_040). Declared retroactively in 1.36.0."
        }
      },
      "indexes": {
        "idx_email": {
          "cols": [
            "email"
          ],
          "since": "1.0.0"
        },
        "idx_phone": {
          "cols": [
            "phone"
          ],
          "since": "1.0.0"
        },
        "idx_birthday_md": {
          "cols": [
            "birthday_md"
          ],
          "since": "1.36.0",
          "comment": "PHASE-0.60B — the daily 'who has a birthday today' read."
        },
        "idx_wp_user": {
          "cols": [
            "wp_user_id"
          ],
          "since": "1.19.0"
        },
        "idx_account": {
          "cols": [
            "account_id"
          ],
          "since": "1.19.0"
        },
        "idx_owner": {
          "cols": [
            "owner_id"
          ],
          "since": "1.19.0"
        },
        "idx_acquisition": {
          "cols": [
            "acquisition_source"
          ],
          "since": "1.19.0"
        },
        "idx_deleted": {
          "cols": [
            "deleted_at"
          ],
          "since": "1.19.0"
        },
        "idx_platform_uid": {
          "cols": [
            "platform",
            "platform_uid"
          ],
          "since": "1.25.0",
          "comment": "Non-unique in the installer (KEY idx_platform_uid); was misdeclared unique until 1.36.0."
        },
        "idx_segment": {
          "cols": [
            "segment"
          ],
          "since": "1.18.0"
        }
      }
    },
    "bizcity_crm_inboxes": {
      "since": "1.0.0",
      "purpose": "Inbox configuration per channel (one inbox = one page/OA/email account). Adapters register inboxes on connect. Admin can set auto_assignment, working hours link, SLA policy.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "name": {
          "type": "VARCHAR(255) NOT NULL DEFAULT ''",
          "since": "1.0.0"
        },
        "channel_type": {
          "type": "VARCHAR(32) NOT NULL",
          "since": "1.0.0",
          "comment": "FACEBOOK | ZALO | WEBCHAT | TELEGRAM | IG | WA | EMAIL"
        },
        "channel_id": {
          "type": "VARCHAR(190) NOT NULL",
          "since": "1.0.0",
          "comment": "Page ID / OA ID / email address"
        },
        "credentials_json": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0",
          "comment": "Encrypted tokens. Server-side only."
        },
        "settings_json": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0"
        },
        "working_hours_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.0.0"
        },
        "sla_policy_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.0.0"
        },
        "status": {
          "type": "VARCHAR(16) NOT NULL DEFAULT 'active'",
          "since": "1.0.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        }
      },
      "indexes": {
        "idx_channel": {
          "cols": [
            "channel_type",
            "channel_id"
          ],
          "since": "1.0.0",
          "unique": true
        }
      }
    },
    "bizcity_crm_conversations": {
      "since": "1.0.0",
      "purpose": "Omni-channel conversation (thread) between 1 contact and agents. One conversation = one continuous interaction session in inbox. Supports labels, custom attributes, SLA, snooze.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "inbox_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.0.0"
        },
        "contact_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.0.0"
        },
        "assignee_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.0.0"
        },
        "status": {
          "type": "VARCHAR(16) NOT NULL DEFAULT 'open'",
          "since": "1.0.0",
          "comment": "open | resolved | pending | snoozed"
        },
        "priority": {
          "type": "VARCHAR(16) NOT NULL DEFAULT 'none'",
          "since": "1.0.0",
          "comment": "none | low | medium | high | urgent"
        },
        "channel_conversation_id": {
          "type": "VARCHAR(190) NULL",
          "since": "1.0.0",
          "comment": "Platform-side thread id for dedup"
        },
        "snoozed_until": {
          "type": "DATETIME NULL",
          "since": "1.0.0"
        },
        "first_reply_at": {
          "type": "DATETIME NULL",
          "since": "1.0.0"
        },
        "resolved_at": {
          "type": "DATETIME NULL",
          "since": "1.0.0"
        },
        "acquisition_source": {
          "type": "VARCHAR(128) NULL",
          "since": "1.0.0",
          "comment": "campaign:camp_X | organic | direct"
        },
        "custom_json": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        }
      },
      "indexes": {
        "idx_inbox": {
          "cols": [
            "inbox_id",
            "status"
          ],
          "since": "1.0.0"
        },
        "idx_contact": {
          "cols": [
            "contact_id"
          ],
          "since": "1.0.0"
        },
        "idx_assignee": {
          "cols": [
            "assignee_id"
          ],
          "since": "1.0.0"
        },
        "idx_priority": {
          "cols": [
            "priority",
            "status"
          ],
          "since": "1.0.0"
        }
      }
    },
    "bizcity_crm_messages": {
      "since": "1.0.0",
      "purpose": "Per-message log for a conversation. Stores inbound + outbound messages with platform metadata. Agent notes (private=1) visible only in admin.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "conversation_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.0.0"
        },
        "contact_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.0.0"
        },
        "author_id": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.0.0",
          "comment": "wp_user id; NULL for inbound platform messages"
        },
        "direction": {
          "type": "TINYINT NOT NULL DEFAULT 1",
          "since": "1.0.0",
          "comment": "1=inbound, 2=outbound"
        },
        "body": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0"
        },
        "content_type": {
          "type": "VARCHAR(32) NOT NULL DEFAULT 'text'",
          "since": "1.0.0",
          "comment": "text | image | audio | video | file | template | activity"
        },
        "private": {
          "type": "TINYINT NOT NULL DEFAULT 0",
          "since": "1.0.0",
          "comment": "1=agent note, not sent to customer"
        },
        "meta_json": {
          "type": "LONGTEXT NULL",
          "since": "1.0.0",
          "comment": "Platform message_id, attachments, buttons, etc."
        },
        "platform_msg_id": {
          "type": "VARCHAR(190) NULL",
          "since": "1.0.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "content_storage_state": {
          "type": "VARCHAR(20) NOT NULL DEFAULT 'hot'",
          "since": "1.29.0",
          "comment": "hot | archive_pending | archived | offload_pending | offloaded | archive_failed | offload_failed"
        },
        "content_preview": {
          "type": "VARCHAR(255) NULL",
          "since": "1.29.0"
        },
        "archive_channel": {
          "type": "VARCHAR(32) NULL",
          "since": "1.29.0"
        },
        "archive_account_key": {
          "type": "VARCHAR(128) NULL",
          "since": "1.29.0"
        },
        "archive_peer_key": {
          "type": "VARCHAR(128) NULL",
          "since": "1.29.0"
        },
        "archive_month": {
          "type": "CHAR(7) NULL",
          "since": "1.29.0"
        },
        "archive_receipt_hash": {
          "type": "CHAR(64) NULL",
          "since": "1.29.0"
        },
        "archived_at": {
          "type": "DATETIME NULL",
          "since": "1.29.0"
        },
        "offloaded_at": {
          "type": "DATETIME NULL",
          "since": "1.29.0"
        },
        "storage_error_code": {
          "type": "VARCHAR(64) NULL",
          "since": "1.29.0"
        },
        "storage_attempts": {
          "type": "INT UNSIGNED NOT NULL DEFAULT 0",
          "since": "1.29.0"
        }
      },
      "indexes": {
        "idx_conversation": {
          "cols": [
            "conversation_id",
            "created_at"
          ],
          "since": "1.0.0"
        },
        "idx_platform_msg": {
          "cols": [
            "platform_msg_id"
          ],
          "since": "1.0.0"
        },
        "idx_storage_state": {
          "cols": [
            "content_storage_state",
            "created_at",
            "id"
          ],
          "since": "1.29.0"
        },
        "idx_storage_conversation": {
          "cols": [
            "conversation_id",
            "content_storage_state",
            "created_at"
          ],
          "since": "1.29.0"
        },
        "idx_archive_receipt": {
          "cols": [
            "archive_receipt_hash"
          ],
          "since": "1.29.0"
        }
      }
    },
    "bizcity_crm_labels": {
      "since": "1.0.0",
      "purpose": "Global label definitions used to tag conversations. Color + identifier + description. M3.W1.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "title": {
          "type": "VARCHAR(100) NOT NULL DEFAULT ''",
          "since": "1.0.0"
        },
        "slug": {
          "type": "VARCHAR(100) NOT NULL DEFAULT ''",
          "since": "1.0.0"
        },
        "color": {
          "type": "VARCHAR(16) NOT NULL DEFAULT '#3b82f6'",
          "since": "1.0.0"
        },
        "description": {
          "type": "VARCHAR(255) NULL",
          "since": "1.0.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        }
      },
      "indexes": {
        "uniq_slug": {
          "cols": [
            "slug"
          ],
          "since": "1.0.0",
          "unique": true
        }
      }
    },
    "bizcity_crm_conversation_labels": {
      "since": "1.0.0",
      "purpose": "Many-to-many join between conversations and labels. M3.W1.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.0.0",
          "pk": true
        },
        "conversation_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.0.0"
        },
        "label_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.0.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.0.0"
        }
      },
      "indexes": {
        "uniq_cv_lb": {
          "cols": [
            "conversation_id",
            "label_id"
          ],
          "since": "1.0.0",
          "unique": true
        },
        "idx_label": {
          "cols": [
            "label_id"
          ],
          "since": "1.0.0"
        }
      }
    },
    "bizcity_crm_archive_receipts": {
      "since": "1.29.0",
      "purpose": "Content-free per-message receipt proving encrypted archive write before SQL offload.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.29.0",
          "pk": true
        },
        "crm_message_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.29.0"
        },
        "conversation_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.29.0"
        },
        "inbox_id": {
          "type": "BIGINT UNSIGNED NOT NULL",
          "since": "1.29.0"
        },
        "channel_type": {
          "type": "VARCHAR(32) NOT NULL",
          "since": "1.29.0"
        },
        "account_key": {
          "type": "VARCHAR(128) NOT NULL",
          "since": "1.29.0"
        },
        "peer_key": {
          "type": "VARCHAR(128) NOT NULL",
          "since": "1.29.0"
        },
        "archive_month": {
          "type": "CHAR(7) NOT NULL",
          "since": "1.29.0"
        },
        "archive_schema_version": {
          "type": "SMALLINT UNSIGNED NOT NULL DEFAULT 1",
          "since": "1.29.0"
        },
        "archive_key_version": {
          "type": "VARCHAR(32) NOT NULL DEFAULT 'v1'",
          "since": "1.29.0"
        },
        "line_hash": {
          "type": "CHAR(64) NOT NULL",
          "since": "1.29.0"
        },
        "byte_offset": {
          "type": "BIGINT NULL",
          "since": "1.34.0",
          "comment": "Byte offset of the durable JSONL line; legacy receipts remain NULL."
        },
        "line_bytes": {
          "type": "INT NULL",
          "since": "1.34.0",
          "comment": "Durable JSONL line length in bytes; legacy receipts remain NULL."
        },
        "archive_status": {
          "type": "VARCHAR(16) NOT NULL DEFAULT 'written'",
          "since": "1.29.0",
          "comment": "pending | written | verify_failed | erased"
        },
        "written_at": {
          "type": "DATETIME NULL",
          "since": "1.29.0"
        },
        "verified_at": {
          "type": "DATETIME NULL",
          "since": "1.29.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.29.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.29.0"
        }
      },
      "indexes": {
        "uniq_message_schema": {
          "cols": [
            "crm_message_id",
            "archive_schema_version"
          ],
          "since": "1.29.0",
          "unique": true
        },
        "idx_partition": {
          "cols": [
            "channel_type",
            "account_key",
            "peer_key",
            "archive_month"
          ],
          "since": "1.29.0"
        },
        "idx_status_created": {
          "cols": [
            "archive_status",
            "created_at"
          ],
          "since": "1.29.0"
        }
      }
    },
    "bizcity_crm_teams": {
      "since": "1.31.0",
      "purpose": "Tenant-local CRM operational teams; WP users remain identity source.",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": {
          "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
          "since": "1.31.0",
          "pk": true
        },
        "name": {
          "type": "VARCHAR(190) NOT NULL",
          "since": "1.31.0"
        },
        "description": {
          "type": "TEXT NULL",
          "since": "1.31.0"
        },
        "allow_auto_assign": {
          "type": "TINYINT(1) NOT NULL DEFAULT 1",
          "since": "1.31.0"
        },
        "is_active": {
          "type": "TINYINT(1) NOT NULL DEFAULT 1",
          "since": "1.31.0"
        },
        "created_by": {
          "type": "BIGINT UNSIGNED NULL",
          "since": "1.31.0"
        },
        "created_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.31.0"
        },
        "updated_at": {
          "type": "DATETIME NOT NULL",
          "since": "1.31.0"
        }
      },
      "indexes": {
        "uniq_name": {
          "cols": [
            "name"
          ],
          "since": "1.31.0",
          "unique": true
        },
        "idx_active": {
          "cols": [
            "is_active",
            "allow_auto_assign"
          ],
          "since": "1.31.0"
        }
