{
    "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
    "module_id": "core.skills",
    "owner": "core/twinbrain (bizcity_skills reader + schema registry row) · core/kg-hub (bizcity_journal_entries)",
    "installer_id": "skills",
    "current_version": "1.6.0",
    "version_option": "bizcity_skills_db_version",
    "tables": {
        "bizcity_skills": {
            "since": "1.0.0",
            "purpose": "Machine skill prompt and routing registry. This table is not the canonical Journal authoring store. ORPHANED SCHEMA OWNER (WP-12 N40, 2026-09-27): the owning module core/skills was archived in R3; no installer creates this table on a new site any more. Still read live by BizCity_TwinBrain_Tool_Intent_Matcher::match_keyword_overlap() (now in bizcity-twin-brain-addon/twinbrain/), which checks table existence and falls back to TwinWeb catalog candidates when absent -- so a missing table degrades gracefully, it does not fatal. Retiring this table for real (R13f) needs TwinBrain's matcher to get its candidates from the unified tool catalog instead, which is gated on PHASE-0.87 CL-9 (remove the old client-side PHP reply path) -- not started as of 2026-10-01. Do not drop or quarantine this table before CL-9 ships.",
            "engine": "InnoDB",
            "charset": "utf8mb4",
            "collate": "utf8mb4_unicode_ci",
            "columns": {
                "id": {
                    "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
                    "since": "1.0.0",
                    "pk": true
                },
                "skill_key": {
                    "type": "VARCHAR(128) NOT NULL",
                    "since": "1.0.0"
                },
                "user_id": {
                    "type": "BIGINT UNSIGNED DEFAULT 0",
                    "since": "1.0.0"
                },
                "character_id": {
                    "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",
                    "since": "1.0.0"
                },
                "title": {
                    "type": "VARCHAR(255) NOT NULL",
                    "since": "1.0.0"
                },
                "description": {
                    "type": "TEXT DEFAULT NULL",
                    "since": "1.0.0"
                },
                "category": {
                    "type": "VARCHAR(64) DEFAULT 'general'",
                    "since": "1.0.0"
                },
                "triggers_json": {
                    "type": "TEXT DEFAULT NULL",
                    "since": "1.0.0"
                },
                "slash_commands": {
                    "type": "VARCHAR(512) DEFAULT NULL",
                    "since": "1.0.0"
                },
                "modes": {
                    "type": "VARCHAR(255) DEFAULT NULL",
                    "since": "1.0.0"
                },
                "tools_json": {
                    "type": "TEXT DEFAULT NULL",
                    "since": "1.0.0"
                },
                "content": {
                    "type": "LONGTEXT NOT NULL",
                    "since": "1.0.0"
                },
                "content_hash": {
                    "type": "VARCHAR(64) DEFAULT ''",
                    "since": "1.0.0"
                },
                "pipeline_json": {
                    "type": "LONGTEXT DEFAULT NULL",
                    "since": "1.0.0"
                },
                "priority": {
                    "type": "INT UNSIGNED DEFAULT 50",
                    "since": "1.0.0"
                },
                "status": {
                    "type": "ENUM('draft','active','archived') DEFAULT 'draft'",
                    "since": "1.0.0"
                },
                "version": {
                    "type": "VARCHAR(32) DEFAULT '1.0'",
                    "since": "1.0.0"
                },
                "visibility": {
                    "type": "VARCHAR(16) NOT NULL DEFAULT 'journal'",
                    "since": "1.4.2",
                    "comment": "Presentation boundary: journal or runtime."
                },
                "source_module": {
                    "type": "VARCHAR(64) NOT NULL DEFAULT ''",
                    "since": "1.4.2",
                    "comment": "Owning runtime producer; empty for human Journal-compatible content."
                },
                "created_at": {
                    "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
                    "since": "1.0.0"
                },
                "updated_at": {
                    "type": "DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                    "since": "1.0.0"
                }
            },
            "indexes": {
                "uk_skill_key_user": {
                    "cols": [
                        "skill_key",
                        "user_id",
                        "character_id"
                    ],
                    "since": "1.0.0",
                    "unique": true
                },
                "idx_character": {
                    "cols": [
                        "character_id"
                    ],
                    "since": "1.0.0"
                },
                "idx_user": {
                    "cols": [
                        "user_id"
                    ],
                    "since": "1.0.0"
                },
                "idx_category": {
                    "cols": [
                        "category"
                    ],
                    "since": "1.0.0"
                },
                "idx_status": {
                    "cols": [
                        "status"
                    ],
                    "since": "1.0.0"
                },
                "idx_visibility": {
                    "cols": [
                        "visibility"
                    ],
                    "since": "1.4.2"
                },
                "idx_source_module": {
                    "cols": [
                        "source_module"
                    ],
                    "since": "1.4.2"
                },
                "idx_priority": {
                    "cols": [
                        "priority"
                    ],
                    "since": "1.0.0"
                }
            }
        },
        "bizcity_journal_entries": {
            "since": "1.5.0",
            "purpose": "Canonical user/team Journal authoring entries. KG sources are derived learning projections.",
            "engine": "InnoDB",
            "charset": "utf8mb4",
            "collate": "utf8mb4_unicode_ci",
            "columns": {
                "id": {
                    "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT",
                    "since": "1.5.0",
                    "pk": true
                },
                "owner_user_id": {
                    "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",
                    "since": "1.5.0"
                },
                "workspace_id": {
                    "type": "VARCHAR(64) NOT NULL DEFAULT 'notion'",
                    "since": "1.5.0"
                },
                "title": {
                    "type": "VARCHAR(255) NOT NULL DEFAULT ''",
                    "since": "1.5.0"
                },
                "body": {
                    "type": "LONGTEXT NOT NULL",
                    "since": "1.5.0"
                },
                "status": {
                    "type": "ENUM('draft','captured','published','archived','review','verified','failed','void') NOT NULL DEFAULT 'draft'",
                    "since": "1.7.0",
                    "comment": "journal-entry@1.1.0 state: captured/review/verified/failed/void (+ legacy draft/published/archived). failed = file not kept (Q121-13); verified only by a person (R-JN-14); void = removed from the register, row kept."
                },
                "source_type": {
                    "type": "VARCHAR(32) NOT NULL DEFAULT 'menu'",
                    "since": "1.5.0"
                },
                "source_ref": {
                    "type": "VARCHAR(191) NOT NULL DEFAULT ''",
                    "since": "1.5.0"
                },
                "idempotency_key": {
                    "type": "VARCHAR(191) NOT NULL DEFAULT ''",
                    "since": "1.5.0"
                },
                "revision": {
                    "type": "BIGINT UNSIGNED NOT NULL DEFAULT 1",
                    "since": "1.5.0"
                },
                "learning_status": {
                    "type": "ENUM('not_queued','queued','processing','learned','failed','retryable') NOT NULL DEFAULT 'not_queued'",
                    "since": "1.5.0"
                },
                "learning_error": {
                    "type": "VARCHAR(500) NOT NULL DEFAULT ''",
                    "since": "1.5.0"
                },
                "notebook_id": {
                    "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",
                    "since": "1.5.0"
                },
                "kg_source_id": {
                    "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0",
                    "since": "1.5.0"
                },
                "kind": {
                    "type": "VARCHAR(48) NOT NULL DEFAULT ''",
                    "since": "1.6.0",
                    "comment": "<family>.<type> (journal-kinds@1, docs/contracts/JOURNAL-KINDS-v1.json). Backfilled from source_type on upgrade; never empty after S100-L15."
                },
                "subject_hash": {
                    "type": "CHAR(18) NOT NULL DEFAULT ''",
                    "since": "1.6.0",
                    "comment": "'s-' + 16 hex (R-CID-11 hashed subject). '' = no subject."
                },
                "doc_date": {
                    "type": "DATE NULL DEFAULT NULL",
                    "since": "1.6.0",
                    "comment": "The document's own date (meal day, contract date), not created_at."
                },
                "tags": {
                    "type": "VARCHAR(400) NOT NULL DEFAULT ''",
                    "since": "1.6.0",
                    "comment": "Stored ',a,b,c,' so LIKE '%,tag,%' matches a whole tag."
                },
                "metadata": {
                    "type": "LONGTEXT DEFAULT NULL",
                    "since": "1.5.0",
                    "comment": "journal-entry@1 card/confidence/original/subject/derived_from/flags/by (R-FILESTORE-BUSINESS query-requirement exception: query columns above, body here)."
                },
                "created_at": {
                    "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP",
                    "since": "1.5.0"
                },
                "updated_at": {
                    "type": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
                    "since": "1.5.0"
                }
            },
            "indexes": {
                "uniq_idempotency_key": {
                    "cols": [
                        "idempotency_key"
                    ],
                    "since": "1.5.0",
                    "unique": true
                },
                "idx_owner_status": {
                    "cols": [
                        "owner_user_id",
                        "status"
                    ],
                    "since": "1.5.0"
                },
                "idx_workspace_updated": {
                    "cols": [
                        "workspace_id",
                        "updated_at"
                    ],
                    "since": "1.5.0"
                },
                "idx_learning_status": {
                    "cols": [
                        "learning_status"
                    ],
                    "since": "1.5.0"
                },
                "idx_kg_source": {
                    "cols": [
                        "kg_source_id"
                    ],
                    "since": "1.5.0"
                },
                "idx_owner_kind_date": {
                    "cols": [
                        "owner_user_id",
                        "kind",
                        "doc_date"
                    ],
                    "since": "1.6.0"
                },
                "idx_subject_date": {
                    "cols": [
                        "subject_hash",
                        "doc_date"
                    ],
                    "since": "1.6.0"
                }
            }
        }
    },
    "history": [
        {
            "version": "1.0.0",
            "date": "2026-04-03",
            "change": "Initial machine skill registry schema."
        },
        {
            "version": "1.4.1",
            "date": "2026-07-31",
            "change": "Force re-create on shards where the registry table was missing."
        },
        {
            "version": "1.4.2",
            "date": "2026-08-02",
            "change": "Add visibility and source_module provenance fields to isolate runtime rows from Journal UI."
        },
        {
            "version": "1.4.3",
            "date": "2026-08-02",
            "change": "Repair provenance dbDelta comment parsing and fail closed when required columns are not verified after routed-shard DDL."
        },
        {
            "version": "1.5.0",
            "date": "2026-08-02",
            "change": "Add canonical Journal Entry table with ownership, revision, idempotency, and separate KG learning status."
        },
        {
            "version": "1.5.0",
            "date": "2026-10-01",
            "change": "Documentation only (R13f, WP-12 N40/N20) -- no schema change. Annotated bizcity_skills.purpose as orphaned (owning module core/skills archived; still read by TwinBrain's Tool_Intent_Matcher in the add-on; retirement gated on PHASE-0.87 CL-9, not started)."
        },
        {
            "version": "1.5.0",
            "date": "2026-10-02",
            "change": "Owner decision: feature turned off, data only -- all 45 rows that were status='active' set to status='archived' (bizcity-twin-ai/_notes/bizcity-skills-active-backup-20261002.json has the pre-change snapshot). No schema change; the table, its columns and BizCity_TwinBrain_Tool_Intent_Matcher itself are UNCHANGED and still load on every turn -- load_user_skills() now simply returns no rows, same as the already-supported empty-table case. Do not delete the table or the matcher class; see R13f (WP-12 N20/N40) for why the matcher is load-bearing."
        },
        {
            "version": "1.5.0",
            "date": "2026-10-11",
            "change": "[2026-10-11 12:10 AM Johnny Chu - Chu Hoàng Anh] CORE-REDUCTION WP-20 D-W20-13 — documentation only, no schema change. Owner decision: keep bizcity_skills in use. Schema_Registry row re-homed to core/twinbrain/includes/class-twinbrain-tool-intent-matcher.php (installer null: nothing creates it on new sites; the matcher degrades to [] when absent). Protected by core/twinbrain/tests/harness/wp20-skills-keep-harness.php."
        },
        {
            "version": "1.6.0",
            "date": "2026-10-12",
            "change": "[2026-10-12 12:25 PM Johnny Chu - Chu Hoàng Anh] PHASE-0.100 S100-L15 (R-JOURNAL R-JN-4) — bizcity_journal_entries becomes the one 'client has what, where' index: add kind/subject_hash/doc_date/tags query columns + idx_owner_kind_date/idx_subject_date indexes (BizCity_Journal_Database::ensure_schema() dbDelta diff, bounded idempotent backfill of pre-1.1.0 rows to kind=common.* by source_type). New read/write API BizCity_Journal_Index (class-journal-index.php) and decision function BizCity_Journal_Filer::place() (class-journal-filer.php) sit on top; card body stays in metadata (R-FILESTORE-BUSINESS query-requirement exception, noted here as required)."
        },
        {
            "version": "1.7.0",
            "date": "2026-10-17",
            "change": "[2026-10-17 07:44 PM Johnny Chu - Chu Hoàng Anh] PHASE-0.121 S121-J3 (R-JOURNAL v1.1 R-JN-14) — bizcity_journal_entries.status ENUM + review/verified/failed/void (BizCity_Journal_Database SCHEMA_VERSION 1.2.0, dbDelta alters in place; no data change). Listings hide archived AND void. New lookup get_by_kg_source_id(). journal-entry@1.1.0 runtime schema at core/kg-hub/contracts/JOURNAL-ENTRY-v1.json; one write API bizcity_journal_record(); actions bizcity_journal_entry_added / bizcity_journal_entry_state."
        }
    ]
}
