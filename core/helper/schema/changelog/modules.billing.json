{
  "$schema": "https://bizcity.vn/schema/diagnostics-changelog-v1.json",
  "module_id": "modules.billing",
  "owner": "bizcity-billing-addon/includes/usage",
  "owner_moved": "[2026-10-25 Johnny Chu - Chu Hoàng Anh] PHASE-0.126 R126-BILL (owner: \"6 bảng usage tách usage/ thành add-on billing\") — core/channel-gateway/includes/usage/ is gone from Zalo Brain; the add-on bizcity-billing-addon installs and uses these tables (extension_owned_changelogs). Three installers, each with its own option: BizCity_Usage_Schema (bizcity_usage_ledger_schema — the module version below), BizCity_Brain_Journey_Schema (bizcity_brain_journey_schema), BizCity_Usage_Plan_Sales (bizcity_plan_sales_schema); per-table owner_class / installer_option say which.",
  "installer_id": "billing_usage",
  "current_version": "1.5.0",
  "version_option": "bizcity_usage_ledger_schema",
  "tables": {
    "bizcity_usage_ledger": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.9.0",
      "purpose": "PHASE-0.107 S107-L9/L12 (D107-13) — the site's COPY of its own client ledger (contract usage-ledger@1, cell → Hub forwarder → POST bizcity-channel/v1/usage/ledger-ingest). One row per cell ledger row, UNIQUE(account_id, account_seq). Billed columns only: no cost, no real tokens, no markup, no raw hash. bound_user_id / actor_user_id resolved and frozen at receive time. Site keeps rows forever (Q107-14).",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":            { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.9.0", "pk": true },
        "account_id":    { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "bridge_account_id or web-<key>" },
        "account_seq":   { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "row_ref":       { "type": "VARCHAR(16) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "last 8 hex of the cell row_hash" },
        "kind":          { "type": "VARCHAR(12) NOT NULL DEFAULT 'llm'", "since": "1.9.0", "enum": ["llm", "tool", "adjust", "reversal"] },
        "occurred_at":   { "type": "DATETIME NOT NULL", "since": "1.9.0", "note": "UTC" },
        "occurred_day":  { "type": "DATE NOT NULL", "since": "1.9.0", "note": "site-local date" },
        "platform":      { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "channel_ref":   { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "bound_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "actor_role":    { "type": "VARCHAR(12) NOT NULL DEFAULT 'customer'", "since": "1.9.0" },
        "actor_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "contact_key":   { "type": "VARCHAR(16) NOT NULL DEFAULT ''", "since": "1.9.0", "note": "first 12 hex of contact_ref (never the 64-hex)" },
        "thread_ref":    { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "turn_ref":      { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "surface":       { "type": "VARCHAR(96) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "model":         { "type": "VARCHAR(120) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "tool":          { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "tool_kind":     { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0", "enum": ["", "builtin", "mcp"] },
        "units":         { "type": "DECIMAL(14,4) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_tokens": { "type": "BIGINT NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_usd":    { "type": "DECIMAL(18,8) NULL", "since": "1.9.0", "note": "NULL = tool not priced by the Hub table" },
        "price_source":  { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0", "enum": ["cell", "hub_unit_price", "hub_other"] },
        "price_version": { "type": "VARCHAR(40) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "is_error":      { "type": "TINYINT(1) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "resolve_state": { "type": "VARCHAR(16) NOT NULL DEFAULT 'ok'", "since": "1.9.0", "enum": ["ok", "unknown_account"] },
        "received_at":   { "type": "DATETIME NOT NULL", "since": "1.9.0" }
      },
      "indexes": {
        "uniq_account_seq": { "type": "UNIQUE KEY", "cols": ["account_id", "account_seq"], "since": "1.9.0" },
        "idx_account_time": { "type": "KEY", "cols": ["account_id", "occurred_at"], "since": "1.9.0" },
        "idx_bound_time":   { "type": "KEY", "cols": ["bound_user_id", "occurred_at"], "since": "1.9.0" },
        "idx_actor_time":   { "type": "KEY", "cols": ["actor_user_id", "occurred_at"], "since": "1.9.0" },
        "idx_thread":       { "type": "KEY", "cols": ["thread_ref"], "since": "1.9.0" },
        "idx_day_account":  { "type": "KEY", "cols": ["occurred_day", "account_id"], "since": "1.9.0" }
      }
    },
    "bizcity_usage_daily": {
      "lifecycle": { "wave": "PHASE-0.126 R126-TB", "date": "2026-10-25", "state": "quarantine", "replacement": "derived table over bizcity_usage_ledger (BizCity_Usage_Schema::daily_table())", "drop_candidate": true, "rows": "kept" },
      "since": "1.9.0",
      "purpose": "PHASE-0.107 S107-L9 — aggregate of bizcity_usage_ledger per (day, platform, account_id, bound_user_id, actor_role, actor_user_id, kind); rebuilt from the ledger for every (day, account) an ingest touched. Tiles + daily chart of menu Sử dụng.",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":            { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.9.0", "pk": true },
        "day":           { "type": "DATE NOT NULL", "since": "1.9.0" },
        "platform":      { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "account_id":    { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "bound_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "actor_role":    { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "actor_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "kind":          { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.9.0" },
        "billed_tokens": { "type": "BIGINT NOT NULL DEFAULT 0", "since": "1.9.0" },
        "billed_usd":    { "type": "DECIMAL(18,8) NOT NULL DEFAULT 0", "since": "1.9.0" },
        "turns":         { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "threads":       { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "tool_calls":    { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.9.0" },
        "updated_at":    { "type": "DATETIME NOT NULL", "since": "1.9.0" }
      },
      "indexes": {
        "uniq_group":      { "type": "UNIQUE KEY", "cols": ["day", "platform", "account_id", "bound_user_id", "actor_role", "actor_user_id", "kind"], "since": "1.9.0" },
        "idx_account_day": { "type": "KEY", "cols": ["account_id", "day"], "since": "1.9.0" },
        "idx_bound_day":   { "type": "KEY", "cols": ["bound_user_id", "day"], "since": "1.9.0" },
        "idx_actor_day":   { "type": "KEY", "cols": ["actor_user_id", "day"], "since": "1.9.0" }
      }
    },
    "bizcity_account_plans": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.10.0",
      "purpose": "PHASE-0.107 round 4 S107-L14 (doc 66 §8.1) — the client's commercial plan (trial / pro / other) per ACCOUNT ID, per blog. The site is the source of truth of the plan; the cell is the source of truth of token counts (no token counter is stored). plan_mode defaults to off: no row / off = nothing is blocked. plan_version is monotonic per account and bumped on every change (the cell ignores older versions). Enforced on the SITE (round 5): BizCity_Usage_Plan_Enforce flips the number's AI switch; used tokens are SUM(billed_tokens) of bizcity_usage_ledger and are not stored here. Deliberately NOT a column of the Hub mirror bizcity_zalo_accounts, not BizCity_Plans, not master_level.",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id":                      { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.10.0", "pk": true },
        "platform":                { "type": "VARCHAR(24) NOT NULL DEFAULT 'zalo_personal'", "since": "1.10.0" },
        "account_id":              { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.10.0" },
        "plan_code":               { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.10.0", "note": "trial | pro | any short slug" },
        "state":                   { "type": "VARCHAR(12) NOT NULL DEFAULT 'none'", "since": "1.10.0", "enum": ["none", "trial", "active", "expired"] },
        "plan_mode":               { "type": "VARCHAR(3) NOT NULL DEFAULT 'off'", "since": "1.10.0", "enum": ["on", "off"] },
        "plan_version":            { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0" },
        "started_at":              { "type": "DATETIME NULL", "since": "1.10.0", "note": "UTC; trial: first successful login of the number" },
        "valid_until":             { "type": "DATETIME NULL", "since": "1.10.0", "note": "UTC" },
        "monthly_token_allowance": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "BILLED tokens; 0 = unlimited" },
        "allowance_period":        { "type": "VARCHAR(12) NOT NULL DEFAULT 'month'", "since": "1.10.0", "enum": ["month", "since_start"] },
        "notice_text":             { "type": "VARCHAR(500) NOT NULL DEFAULT ''", "since": "1.10.0" },
        "ai_off_by_plan":           { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.11.0", "note": "plan_expired | plan_allowance_exhausted when WE switched the number's AI off; empty = not ours" },
        "ai_off_at":                { "type": "DATETIME NULL", "since": "1.11.0" },
        "enforce_error":            { "type": "VARCHAR(80) NOT NULL DEFAULT ''", "since": "1.11.0", "note": "last failed AI-switch call; retried by the next trigger" },
        "last_notice_at":           { "type": "DATETIME NULL", "since": "1.11.0", "note": "owner notice dedupe: one per account per day" },
        "last_notice_reason":       { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.11.0" },
        "last_order_id":           { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "Woo order that last extended the plan (L16)" },
        "last_sold_by":            { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0", "note": "WP user of that order" },
        "updated_by":              { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.10.0" },
        "created_at":              { "type": "DATETIME NOT NULL", "since": "1.10.0" },
        "updated_at":              { "type": "DATETIME NOT NULL", "since": "1.10.0" }
      },
      "indexes": {
        "uniq_account": { "type": "UNIQUE KEY", "cols": ["platform", "account_id"], "since": "1.10.0" },
        "idx_state":    { "type": "KEY", "cols": ["state", "valid_until"], "since": "1.10.0" }
      }
    },
    "bizcity_activity_day": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.4.0",
      "purpose": "PHASE-0.112 S112-L1 / S112-W9 — activity-day@1(.1) store: one row per (account_id, day) of the counts the CELL measured (customers, replies, groups, tasks, points, jobs). A cache the cell overwrites whole, never a ledger; nothing here is money, tokens or a contact. measured 0 = the cell was not measuring that day. Created by BizCity_Usage_Schema since SCHEMA_VERSION 1.4.0 (1.5.0 adds points / jobs_* / efficiency_score / points_rev). Was created but never declared before PHASE-0.126 R126-BILL.",
      "owner_class": "BizCity_Usage_Schema",
      "installer_option": "bizcity_usage_ledger_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "account_id": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.4.0" },
        "day": { "type": "DATE NOT NULL", "since": "1.4.0", "note": "site-local date" },
        "measured": { "type": "TINYINT(1) NOT NULL DEFAULT 1", "since": "1.4.0" },
        "customers": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "replies": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "customers_new": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "replies_failed": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "groups_active": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "tasks": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "tasks_by_label": { "type": "TEXT NULL", "since": "1.4.0", "note": "the cell's own JSON, capped at ingest" },
        "by_channel": { "type": "TEXT NULL", "since": "1.4.0" },
        "groups_joined": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "connections_active": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "streak_days": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "ledger_to_seq": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.4.0" },
        "points": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.5.0" },
        "jobs_done": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.5.0" },
        "jobs_failed": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.5.0" },
        "jobs_by_kind": { "type": "TEXT NULL", "since": "1.5.0" },
        "efficiency_score": { "type": "DECIMAL(4,1) NULL", "since": "1.5.0" },
        "points_rev": { "type": "VARCHAR(40) NOT NULL DEFAULT ''", "since": "1.5.0" },
        "received_at": { "type": "DATETIME NOT NULL", "since": "1.4.0" }
      },
      "indexes": {
        "PRIMARY": { "pk": true, "cols": ["account_id","day"], "since": "1.4.0" },
        "idx_day": { "type": "KEY", "cols": ["day"], "since": "1.4.0" }
      }
    },
    "bizcity_brain_journey": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.0.0",
      "purpose": "PHASE-0.108 S108-L1 (brain-journey@1) — append-only, hash-chained journal of milestones / badges / owner ladder steps per subject (subject_kind brain = one account_id, owner = one WP user, site = site-wide). occurred_at UTC; owner_user_id = owner AT THE MOMENT the row was written (never rewritten). Created by BizCity_Brain_Journey_Schema (option bizcity_brain_journey_schema). Was created but never declared before PHASE-0.126 R126-BILL.",
      "owner_class": "BizCity_Brain_Journey_Schema",
      "installer_option": "bizcity_brain_journey_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "id": { "type": "BIGINT UNSIGNED NOT NULL AUTO_INCREMENT", "since": "1.0.0", "pk": true },
        "seq": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "occurred_at": { "type": "DATETIME NOT NULL", "since": "1.0.0" },
        "subject_kind": { "type": "VARCHAR(12) NOT NULL DEFAULT 'brain'", "since": "1.0.0", "enum": ["brain", "owner", "site"] },
        "subject_id": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "owner_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "event": { "type": "VARCHAR(16) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "code": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "tier": { "type": "VARCHAR(12) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "value": { "type": "BIGINT NOT NULL DEFAULT 0", "since": "1.0.0" },
        "catalog_version": { "type": "VARCHAR(32) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "source": { "type": "VARCHAR(24) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "source_ref": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "dedupe_key": { "type": "VARCHAR(160) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "prev_hash": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "row_hash": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "created_at": { "type": "DATETIME NOT NULL", "since": "1.0.0" }
      },
      "indexes": {
        "uniq_dedupe": { "type": "UNIQUE KEY", "unique": true, "cols": ["dedupe_key"], "since": "1.0.0" },
        "uniq_subject_seq": { "type": "UNIQUE KEY", "unique": true, "cols": ["subject_kind","subject_id","seq"], "since": "1.0.0" },
        "idx_subject_time": { "type": "KEY", "cols": ["subject_kind","subject_id","occurred_at"], "since": "1.0.0" },
        "idx_owner_time": { "type": "KEY", "cols": ["owner_user_id","occurred_at"], "since": "1.0.0" },
        "idx_event": { "type": "KEY", "cols": ["event","occurred_at"], "since": "1.0.0" }
      }
    },
    "bizcity_brain_journey_heads": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.0.0",
      "purpose": "PHASE-0.108 S108-L1 — head of each subject's hash chain in bizcity_brain_journey (last seq + last hash), so an append never scans the journal. Created by BizCity_Brain_Journey_Schema. Was created but never declared before PHASE-0.126 R126-BILL.",
      "owner_class": "BizCity_Brain_Journey_Schema",
      "installer_option": "bizcity_brain_journey_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "subject_kind": { "type": "VARCHAR(12) NOT NULL DEFAULT 'brain'", "since": "1.0.0" },
        "subject_id": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "last_seq": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "last_hash": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "updated_at": { "type": "DATETIME NOT NULL", "since": "1.0.0" }
      },
      "indexes": {
        "PRIMARY": { "pk": true, "cols": ["subject_kind","subject_id"], "since": "1.0.0" }
      }
    },
    "bizcity_brain_metrics": {
      "lifecycle": { "wave": "PHASE-0.126 R126-BILL", "date": "2026-10-25", "state": "extension_owned", "replacement": "owned by bizcity-billing-addon", "drop_candidate": false, "rows": "kept" },
      "since": "1.0.0",
      "purpose": "PHASE-0.108 (D108-4, 10-SPEC §9 G-2/G-3/G-4) — per-account cache of the achievements figures, always rebuilt whole-row from bizcity_usage_ledger + Woo, never incremented. customer_replies / distinct_customers are LIFETIME totals (milestone thresholds); the _month columns feed \\\"làm thay\\\" and the efficiency ratio; ai_enabled tells idle apart from AI-off. Created by BizCity_Brain_Journey_Schema (1.1.0 adds the _month columns + ai_enabled). Was created but never declared before PHASE-0.126 R126-BILL.",
      "owner_class": "BizCity_Brain_Journey_Schema",
      "installer_option": "bizcity_brain_journey_schema",
      "engine": "InnoDB",
      "charset": "utf8mb4",
      "collate": "utf8mb4_unicode_ci",
      "columns": {
        "account_id": { "type": "VARCHAR(64) NOT NULL DEFAULT ''", "since": "1.0.0" },
        "platform": { "type": "VARCHAR(24) NOT NULL DEFAULT 'zalo_personal'", "since": "1.0.0" },
        "owner_user_id": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "customer_replies": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "distinct_customers": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "distinct_groups": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "tasks_done": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "trained_items": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "streak_days": { "type": "INT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "billed_tokens_month": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.0.0" },
        "chi_usd_month": { "type": "DECIMAL(18,8) NOT NULL DEFAULT 0", "since": "1.0.0" },
        "thu_usd_month": { "type": "DECIMAL(18,8) NOT NULL DEFAULT 0", "since": "1.0.0" },
        "customer_replies_month": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
        "distinct_customers_month": { "type": "BIGINT UNSIGNED NOT NULL DEFAULT 0", "since": "1.1.0" },
