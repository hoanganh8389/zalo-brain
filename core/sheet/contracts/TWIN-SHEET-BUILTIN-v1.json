{
    "contract": "twin-sheet-builtin@1.0.0",
    "_stamp": "[2026-10-19 09:12 PM Johnny Chu - Chu Hoàng Anh] PHASE-0.123 W1 (D123-3, B1) — new file: typed columns of the built-in Twin Sheets (\"Sổ\"). One sheet per journal kind; rows are bizcity_journal_entries rows, never a second store (D123-1). Every `source: card` field must be one of the kind's card_fields in JOURNAL-KINDS-v1.json or listed in `system_fields` (tests/unit/TwinSheetS123Test.php). Field values match what the cell writes today (zalo-hub/src/sheets/journal-map.ts).",
    "field_types": ["text", "long_text", "integer", "money", "decimal", "boolean", "date", "datetime", "select", "percent", "ref_code"],
    "sheets": {
        "fin.cash": {
            "label": "Sổ thu chi",
            "icon": "cash",
            "folder": "Tài chính",
            "edit_policy": "void_reenter",
            "create_defaults": { "currency": "VND" },
            "system_fields": ["status"],
            "pair_cancel": { "marker_field": "status", "marker": "reversal", "link_field": "reverses" },
            "fields": [
                { "key": "doc_date", "label": "Ngày", "type": "date", "source": "column", "filter": true, "sort": true },
                { "key": "type", "label": "Thu / Chi", "type": "select", "options": [ { "v": "income", "label": "Thu" }, { "v": "expense", "label": "Chi" } ], "required": true, "filter": true, "group": true },
                { "key": "amount", "label": "Số tiền", "type": "money", "currency_field": "currency", "required": true, "min": 1, "max": 500000000, "sort": true, "aggregate": ["sum", "min", "max", "avg"] },
                { "key": "category", "label": "Hạng mục", "type": "text", "filter": true, "group": true, "search": true },
                { "key": "counterparty", "label": "Người / nơi", "type": "text", "filter": true, "group": true, "search": true },
                { "key": "description", "label": "Ghi chú", "type": "long_text", "search": true },
                { "key": "currency", "label": "Tiền tệ", "type": "select", "options": [ { "v": "VND", "label": "₫" } ], "hidden": true },
                { "key": "reverses", "label": "Đảo của", "type": "text", "hidden": true },
                { "key": "status", "label": "Loại dòng", "type": "select", "options": [ { "v": "active", "label": "Thường" }, { "v": "reversal", "label": "Bút toán đảo" } ], "hidden": true },
                { "key": "ref_code", "label": "Mã", "type": "ref_code", "source": "computed" }
            ],
            "views": [
                { "key": "month", "label": "Tháng này", "period": "month", "sort": [ { "field": "doc_date", "dir": "desc" } ], "totals": [ { "field": "amount", "fn": "sum", "split_by": "type" } ] },
                { "key": "all", "label": "Tất cả", "period": "all", "sort": [ { "field": "doc_date", "dir": "desc" } ], "totals": [ { "field": "amount", "fn": "sum", "split_by": "type" } ] }
            ],
            "headline": { "field": "amount", "fn": "sum", "where": { "type": "expense" }, "period": "month", "label": "Chi tháng này" }
        },
        "fin.debt": {
            "label": "Sổ công nợ",
