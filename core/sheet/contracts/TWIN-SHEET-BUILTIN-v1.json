                { "key": "target", "label": "Mục tiêu", "type": "money", "required": true, "min": 1, "max": 100000000000, "sort": true, "aggregate": ["sum"] },
                { "key": "period_start", "label": "Từ", "type": "date", "required": true, "sort": true },
                { "key": "period_end", "label": "Đến", "type": "date", "required": true, "sort": true },
                { "key": "status", "label": "Trạng thái", "type": "select", "options": [ { "v": "active", "label": "Đang áp dụng" }, { "v": "void", "label": "Đã hủy" } ], "filter": true },
                { "key": "ref_code", "label": "Mã", "type": "ref_code", "source": "computed" }
            ],
            "views": [ { "key": "all", "label": "Tất cả", "period": "all", "sort": [ { "field": "period_start", "dir": "desc" } ] } ]
        },
        "task.progress": {
            "label": "Sổ tiến độ",
            "icon": "progress",
            "folder": "Công việc",
            "edit_policy": "rev",
            "fields": [
                { "key": "doc_date", "label": "Ngày", "type": "date", "source": "column", "filter": true, "sort": true },
                { "key": "subject", "label": "Việc / dự án", "type": "text", "required": true, "filter": true, "group": true, "search": true },
                { "key": "percent", "label": "Tiến độ", "type": "percent", "required": true, "sort": true, "aggregate": ["avg", "max", "min"] },
                { "key": "status", "label": "Trạng thái", "type": "select", "options": [ { "v": "planned", "label": "Chưa bắt đầu" }, { "v": "doing", "label": "Đang làm" }, { "v": "blocked", "label": "Đang vướng" }, { "v": "done", "label": "Xong" } ], "required": true, "filter": true, "group": true },
                { "key": "assignee", "label": "Người làm", "type": "text", "filter": true, "group": true },
                { "key": "due_date", "label": "Hạn", "type": "date", "filter": true, "sort": true },
                { "key": "note", "label": "Ghi chú", "type": "long_text", "search": true },
                { "key": "ref_code", "label": "Mã", "type": "ref_code", "source": "computed" }
            ],
            "views": [ { "key": "all", "label": "Tất cả", "period": "all", "sort": [ { "field": "doc_date", "dir": "desc" } ] } ]
        },
        "task.todo": {
            "label": "Việc cần làm",
            "icon": "todo",
            "folder": "Công việc",
            "edit_policy": "rev",
            "title_rule": "todo",
            "create_defaults": { "done": 0, "version": 1, "priority": "normal", "status": "active" },
            "latest_by": { "key": "source_ref", "order_field": "version" },
            "fields": [
                { "key": "title", "label": "Việc", "type": "text", "required": true, "search": true, "sort": true },
                { "key": "done", "label": "Xong", "type": "boolean", "filter": true, "group": true },
                { "key": "priority", "label": "Ưu tiên", "type": "select", "options": [ { "v": "high", "label": "Cao" }, { "v": "normal", "label": "Thường" }, { "v": "low", "label": "Thấp" } ], "filter": true, "group": true },
                { "key": "assignee", "label": "Người làm", "type": "text", "filter": true, "group": true },
                { "key": "due_date", "label": "Hạn", "type": "date", "filter": true, "sort": true },
                { "key": "note", "label": "Ghi chú", "type": "long_text", "search": true },
                { "key": "status", "label": "Trạng thái", "type": "select", "options": [ { "v": "active", "label": "Đang có" }, { "v": "void", "label": "Đã bỏ" } ], "filter": true, "hidden": true },
                { "key": "version", "label": "Bản", "type": "integer", "hidden": true },
                { "key": "ref_code", "label": "Mã", "type": "ref_code", "source": "computed" }
            ],
            "views": [ { "key": "all", "label": "Tất cả", "period": "all", "sort": [ { "field": "due_date", "dir": "asc" } ] } ],
            "headline": { "field": "title", "fn": "count", "where": { "done": false }, "period": "all", "label": "Việc chưa xong" }
