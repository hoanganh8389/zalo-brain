<?php
/**
 * BizCity Zalo Bot — Frontend Profile View
 * Route: /tool-zalo-bizcity/?tab=bot|hotline
 *
 * Variables in scope (set by BizCity_Tool_Zalo_Page::render()):
 *   $tab              — 'bot' | 'hotline'
 *   $saved            — bool (just saved?)
 *   $bot_account      — array of decrypted zalo_bot row 0
 *   $hotline_account  — array of decrypted zalo_hotline row 0
 *   $bot_settings     — array of field defs from WaicChannelIntegration_zalobot::getSettings()
 *   $hotline_settings — array from WaicChannelIntegration_zalo_hotline::getSettings()
 *   $nonce_field      — pre-rendered nonce <input>
 *   $post_url         — admin-post.php URL
 *   $waic_dialog      — fallback link to WAIC integrations dialog
 *   $user_id          — current WP user id
 *
 * @package BizCity\ZaloBot
 */
if ( ! defined( 'ABSPATH' ) ) exit;

/**
 * Render a single field row from a WAIC integration setting definition.
 * Mirrors the subset of types we actually use (input, html, select, readonly).
 */
$render_field = function ( $key, $cfg, $value ) {
	if ( strpos( $key, '_' ) === 0 && empty( $cfg['type'] ) ) {
		return; // skip ghost keys
	}
	$type     = $cfg['type'] ?? 'input';
	$label    = $cfg['label'] ?? $key;
	$plh      = $cfg['plh'] ?? '';
	$desc     = $cfg['desc'] ?? '';
	$readonly = ! empty( $cfg['readonly'] );
	$encrypt  = ! empty( $cfg['encrypt'] );

	if ( $type === 'html' ) {
		echo '<div class="bzz-guide">' . wp_kses_post( $cfg['content'] ?? '' ) . '</div>';
		return;
	}

	echo '<div class="bzz-row">';
	echo '<label class="bzz-label">' . esc_html( $label );
	if ( $encrypt ) {
		echo ' <span class="bzz-lock" title="encrypted at rest">🔒</span>';
	}
	echo '</label>';

	if ( $type === 'select' && ! empty( $cfg['options'] ) ) {
		echo '<select class="bzz-input" name="fields[' . esc_attr( $key ) . ']"' . ( $readonly ? ' disabled' : '' ) . '>';
		foreach ( $cfg['options'] as $ov => $ol ) {
			echo '<option value="' . esc_attr( $ov ) . '"' . selected( (string) $value, (string) $ov, false ) . '>' . esc_html( $ol ) . '</option>';
		}
		echo '</select>';
	} else {
		$input_type = ( $encrypt && $value ) ? 'password' : 'text';
		echo '<input type="' . esc_attr( $input_type ) . '" class="bzz-input"';
		echo ' name="fields[' . esc_attr( $key ) . ']"';
		echo ' value="' . esc_attr( $value ) . '"';
		echo ' placeholder="' . esc_attr( $plh ) . '"';
		if ( $readonly ) echo ' readonly';
		echo ' />';
	}

	if ( $desc ) {
		echo '<div class="bzz-desc">' . wp_kses_post( $desc ) . '</div>';
	}
	echo '</div>';
};
?>
<style>
.bzz-wrap { max-width: 960px; margin: 30px auto; padding: 0 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.bzz-tabs { display: flex; gap: 0; border-bottom: 2px solid #0084ff; margin-bottom: 24px; }
.bzz-tab { padding: 12px 24px; cursor: pointer; text-decoration: none; background: #f0f2f5; color: #65676b; font-weight: 600; border-radius: 8px 8px 0 0; transition: all .2s; }
.bzz-tab.active { background: #0084ff; color: #fff; }
.bzz-card { background: #fff; border-radius: 12px; padding: 24px; margin-bottom: 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.bzz-card h2 { margin-top: 0; font-size: 18px; color: #0f172a; }
.bzz-row { margin-bottom: 16px; }
.bzz-label { display: block; font-weight: 600; font-size: 13px; color: #334155; margin-bottom: 6px; }
.bzz-input { width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; background: #fff; }
.bzz-input:focus { outline: none; border-color: #0084ff; box-shadow: 0 0 0 3px rgba(0,132,255,.15); }
.bzz-input[readonly] { background: #f1f5f9; color: #64748b; }
.bzz-desc { font-size: 12px; color: #64748b; margin-top: 4px; line-height: 1.5; }
.bzz-guide { background: #fffbeb; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; line-height: 1.6; }
.bzz-btn { display: inline-block; padding: 10px 24px; border-radius: 8px; border: none; cursor: pointer; font-weight: 600; font-size: 14px; text-decoration: none; transition: all .2s; }
.bzz-btn-primary { background: #0084ff; color: #fff; }
.bzz-btn-primary:hover { background: #0070d4; }
.bzz-btn-link { background: transparent; color: #475569; padding: 10px 16px; }
.bzz-status-ok { background: #d1fae5; border-left: 4px solid #10b981; color: #065f46; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; }
.bzz-status-warn { background: #fef3c7; border-left: 4px solid #f59e0b; color: #92400e; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; }
.bzz-lock { font-size: 11px; color: #6b7280; }
.bzz-account-name { font-weight: 600; color: #0f172a; padding: 4px 10px; background: #e0f2fe; border-radius: 999px; display: inline-block; font-size: 12px; }
</style>

<div class="bzz-wrap">
	<h1>💬 Zalo Bizcity Studio</h1>
	<p style="color:#64748b">Cấu hình 2 kênh Zalo trong cùng 1 chỗ — Bot OA (chat tự động) và Hotline ZNS (gửi mẫu thông báo).</p>

	<?php if ( $saved ) : ?>
		<div class="bzz-status-ok">✅ Đã lưu cấu hình. Hệ thống vừa chạy <code>doTest()</code> để xác minh — kiểm tra status ở Tích hợp bên ngoài nếu vẫn báo lỗi.</div>
	<?php endif; ?>

	<div class="bzz-tabs">
		<a href="?tab=bot" class="bzz-tab <?php echo $tab === 'bot' ? 'active' : ''; ?>">🤖 Zalo Bot OA</a>
		<a href="?tab=hotline" class="bzz-tab <?php echo $tab === 'hotline' ? 'active' : ''; ?>">📞 Zalo Hotline (ZNS)</a>
	</div>

	<?php if ( $tab === 'bot' ) : ?>
		<div class="bzz-card">
			<h2>🤖 Cấu hình Zalo Bot (Official Account)</h2>
			<?php if ( ! empty( $bot_account['name'] ) ) : ?>
				<p>Đang chỉnh sửa: <span class="bzz-account-name"><?php echo esc_html( $bot_account['name'] ); ?></span></p>
			<?php endif; ?>

			<?php if ( empty( $bot_settings ) ) : ?>
				<div class="bzz-status-warn">⚠ WAIC integration class chưa load — có thể plugin <code>bizcity-automation</code> không active. Mở <a href="<?php echo esc_url( $waic_dialog ); ?>">Tích hợp bên ngoài</a> để kiểm tra.</div>
			<?php else : ?>
				<form method="post" action="<?php echo esc_url( $post_url ); ?>">
					<?php echo $nonce_field; // phpcs:ignore ?>
					<input type="hidden" name="action" value="<?php echo esc_attr( BizCity_Tool_Zalo_Page::ACTION ); ?>">
					<input type="hidden" name="integ_code" value="zalo_bot">

					<?php
					foreach ( $bot_settings as $key => $cfg ) {
						$value = $bot_account[ $key ] ?? ( $cfg['default'] ?? '' );
						$render_field( $key, $cfg, $value );
					}
					?>

					<div style="margin-top:20px">
						<button type="submit" class="bzz-btn bzz-btn-primary">💾 Lưu cấu hình Bot OA</button>
						<a href="<?php echo esc_url( $waic_dialog ); ?>" class="bzz-btn bzz-btn-link">⚙ Mở dialog WAIC (nâng cao)</a>
					</div>
				</form>
			<?php endif; ?>
		</div>

	<?php else : /* hotline tab */ ?>

		<div class="bzz-card">
			<h2>📞 Cấu hình Zalo Hotline (ZNS Template)</h2>
			<?php if ( ! empty( $hotline_account['name'] ) ) : ?>
				<p>Đang chỉnh sửa: <span class="bzz-account-name"><?php echo esc_html( $hotline_account['name'] ); ?></span></p>
			<?php endif; ?>

			<?php if ( empty( $hotline_settings ) ) : ?>
				<div class="bzz-status-warn">⚠ WAIC integration class <code>WaicChannelIntegration_zalo_hotline</code> chưa load — kiểm tra plugin <code>bizcity-admin-hook-zalo</code> đã active chưa.</div>
			<?php else : ?>
				<form method="post" action="<?php echo esc_url( $post_url ); ?>">
					<?php echo $nonce_field; // phpcs:ignore ?>
					<input type="hidden" name="action" value="<?php echo esc_attr( BizCity_Tool_Zalo_Page::ACTION ); ?>">
					<input type="hidden" name="integ_code" value="zalo_hotline">

					<?php
					foreach ( $hotline_settings as $key => $cfg ) {
						$value = $hotline_account[ $key ] ?? ( $cfg['default'] ?? '' );
						$render_field( $key, $cfg, $value );
					}
					?>

					<div style="margin-top:20px">
						<button type="submit" class="bzz-btn bzz-btn-primary">💾 Lưu cấu hình Hotline ZNS</button>
						<a href="<?php echo esc_url( $waic_dialog ); ?>" class="bzz-btn bzz-btn-link">⚙ Mở dialog WAIC (nâng cao)</a>
					</div>
				</form>
			<?php endif; ?>
		</div>

	<?php endif; ?>
</div>
